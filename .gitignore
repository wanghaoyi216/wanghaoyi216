# 凭据类文件：绝对不要提交到公开仓库
token.txt
*.token
.env
.env.*
!.env.example
id_rsa
id_ed25519
*.pem
*.key

# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# 本地预览/校验页，不进公开仓库
preview/

# 贪吃蛇 workflow：文件已就位，但当前 PAT 缺 Workflows 权限，
# 提交会被 GitHub 拒绝（refusing to allow a Personal Access Token to
# create or update workflow），会连带整次 push 失败。
# 令牌在 https://github.com/settings/personal-access-tokens 勾上
# Repository permissions → Workflows → Read and write 之后，删掉下面这行再提交。
.github/workflows/snake.yml
